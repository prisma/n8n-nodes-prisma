{
	"name": "@prisma/n8n-nodes-prisma",
	"version": "0.1.0",
	"description": "n8n community node for Prisma Postgres: create and manage projects, databases and connections from n8n workflows",
	"license": "MIT",
	"homepage": "https://github.com/prisma/n8n-nodes-prisma#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"prisma",
		"prisma-postgres",
		"postgres",
		"postgresql",
		"pgvector",
		"database"
	],
	"author": {
		"name": "Ankur Datta",
		"email": "datta@prisma.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prisma/n8n-nodes-prisma.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "vitest run --exclude test/integration",
		"test:integration": "vitest run test/integration",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit -p tsconfig.test.json"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PrismaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/PrismaPostgres/PrismaPostgres.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"eslint": "9.32.0",
		"pg": "^8.23.1",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/prisma/n8n-nodes-prisma/issues"
	},
	"engines": {
		"node": ">=20.19"
	}
}
